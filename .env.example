# Copy to .env and fill in. Never commit .env.
# --- Gemini (free tier: https://aistudio.google.com/apikey ) ---
GEMINI_API_KEY=

# --- Gmail delivery (use an App Password, not your normal password:
#     https://myaccount.google.com/apppasswords ) ---
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_TO=you@gmail.com

# --- Optional ---
# Public URL of your dashboard (used for links in the email footer).
DASHBOARD_URL=https://YOUR_GITHUB_USERNAME.github.io/YOUR_REPO/
# GitHub token for the repo-collector (auto-provided inside GitHub Actions).
GITHUB_TOKEN=
# Free Hugging Face token (https://huggingface.co/settings/tokens) — enables the
# "HF Daily Papers" source, which now requires auth. Leave blank to skip that source.
HF_TOKEN=
