<!doctype html>
<html>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>
<body style="margin:0;background:#f4f5f7;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#1a1a2e;">
<div style="max-width:680px;margin:0 auto;padding:24px 16px;">

  <div style="font-size:13px;color:#6b7280;letter-spacing:.04em;text-transform:uppercase;">AI Research Daily</div>
  <h1 style="font-size:22px;margin:4px 0 2px;">{{ date }}</h1>

{% if mode == "revisit" %}
  {% if revisit %}
  <div style="background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:20px;margin-top:16px;">
    <div style="font-size:13px;color:#b45309;font-weight:600;">📚 RESEARCH WORTH REVISITING</div>
    <p style="font-size:12px;color:#6b7280;margin:6px 0 0;">Today's fresh research was thin, so here is an older paper worth your time.</p>
    <h2 style="font-size:18px;margin:12px 0 4px;"><a href="{{ revisit.url }}" style="color:#1a1a2e;">{{ revisit.title }}</a></h2>
    <p style="font-size:12px;color:#6b7280;margin:0 0 12px;">{{ revisit.authors }} · {{ revisit.published_at[:10] if revisit.published_at }}</p>
    {% for label, key in [("What it introduced","introduced"),("How the method works","how_it_works"),("Why it was important","why_important"),("Still relevant?","still_relevant"),("What came after","what_came_after"),("What to learn from it today","learn_today")] %}
      {% if revisit.retro.get(key) %}
      <p style="margin:10px 0 2px;font-weight:600;font-size:14px;">{{ label }}</p>
      <p style="margin:0;font-size:14px;line-height:1.55;">{{ revisit.retro[key] }}</p>
      {% endif %}
    {% endfor %}
  </div>
  {% else %}
  <p style="margin-top:16px;font-size:14px;">No qualifying research today and no revisit candidate could be fetched. Nothing to report.</p>
  {% endif %}

{% else %}

  {% if thirty_seconds %}
  <div style="background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:18px 20px;margin-top:16px;">
    <div style="font-weight:700;font-size:14px;margin-bottom:8px;">⏱️ Today's AI in 30 Seconds</div>
    <ul style="margin:0;padding-left:20px;font-size:14px;line-height:1.6;">
      {% for b in thirty_seconds %}<li>{{ b }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  {% macro card(it, accent) %}
  <div style="background:#fff;border:1px solid #e5e7eb;border-left:4px solid {{ accent }};border-radius:10px;padding:16px 18px;margin-top:14px;">
    <h3 style="margin:0 0 2px;font-size:16px;"><a href="{{ it.url }}" style="color:#1a1a2e;">{{ it.title }}</a></h3>
    <p style="margin:0 0 10px;font-size:12px;color:#6b7280;">
      {{ it.category }} · score {{ '%.1f'|format(it.overall_score) }} · {{ it.claim_type }}
      {% if it.published_at %} · {{ it.published_at[:10] }}{% endif %}
    </p>
    {% if it.one_line %}<p style="margin:6px 0;font-size:14px;"><em>{{ it.one_line }}</em></p>{% endif %}
    {% for label, key in [("Problem","problem"),("Method","method"),("Results","results"),("Why it matters","why_it_matters"),("Future potential","future_potential"),("Project idea","project_idea")] %}
      {% if it.get(key) %}<p style="margin:6px 0 0;font-size:13.5px;line-height:1.5;"><strong>{{ label }}:</strong> {{ it[key] }}</p>{% endif %}
    {% endfor %}
    <p style="margin:10px 0 0;font-size:13px;">
      {% for label, key in [("Paper","url"),("PDF","pdf_url"),("Code","code_url"),("Project","project_url"),("Dataset","dataset_url")] %}
        {% if it.get(key) %}<a href="{{ it[key] }}" style="color:#2563eb;margin-right:12px;">{{ label }} →</a>{% endif %}
      {% endfor %}
    </p>
  </div>
  {% endmacro %}

  <div style="margin-top:22px;font-weight:700;font-size:15px;">🔥 Today's Most Important AI Development</div>
  {{ card(hero, "#ef4444") }}

  {% if computer_vision %}
  <div style="margin-top:22px;font-weight:700;font-size:15px;">👁️ AI Vision / Computer Vision</div>
  {% for it in computer_vision %}{{ card(it, "#8b5cf6") }}{% endfor %}
  {% endif %}

  {% if other %}
  <div style="margin-top:22px;font-weight:700;font-size:15px;">🧠 Other Important AI Research</div>
  {% for it in other %}{{ card(it, "#0ea5e9") }}{% endfor %}
  {% endif %}

  {% if recommendation and recommendation.reason %}
  <div style="background:#fffbeb;border:1px solid #fcd34d;border-radius:12px;padding:18px 20px;margin-top:22px;">
    <div style="font-weight:700;font-size:14px;">⭐ Today's Recommendation</div>
    <p style="margin:8px 0 4px;font-size:14px;"><strong>If you read only one thing today, read this:</strong></p>
    <p style="margin:0 0 6px;font-size:14px;"><a href="{{ recommendation.url }}" style="color:#2563eb;">{{ recommendation.title }}</a></p>
    <p style="margin:0;font-size:14px;line-height:1.55;">{{ recommendation.reason }}</p>
  </div>
  {% endif %}

{% endif %}

  <p style="margin-top:26px;font-size:13px;color:#6b7280;text-align:center;">
    {% if dashboard_url %}<a href="{{ dashboard_url }}" style="color:#2563eb;">Open the research dashboard →</a><br>{% endif %}
    Generated automatically · quality over quantity
  </p>
</div>
</body>
</html>
